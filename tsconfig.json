{
  "compilerOptions": {
    /* ---- Salida ---- */
    "rootDir": "." /* Solo compilar carpeta raíz */,
    "outDir": "dist" /* Carpeta de salida después de compilar */,

    /* ---- Módulos y JS ---- */
    "target": "ES2023" /* Versión de JS a compilar - Soporte Node 20+ */,
    "module": "Node16",
    "moduleResolution": "Node16",

    "isolatedModules": true,

    // "typeRoots": ["./node_modules/@types", "./src/types"],
    "types": ["node"],

    /* ---- Declaration - Genera tipos .d.ts ---- */
    "declaration": false,
    "declarationMap": false,

    /* ---- Compatibilidad ---- */
    "esModuleInterop": true /* Permitir importaciones de módulos CommonJS */,
    "resolveJsonModule": true /* Importar archivos .json */,
    "allowSyntheticDefaultImports": true,

    /* ---- Compilación Incremental - Optimiza builds consecutivas ---- */
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",

    /* ---- Strictness Avanzada ---- */
    "strict": true /* Habilita todas las comprobaciones estrictas */,
    /* NOTA: Deshabilitado temporalmente - requiere validar req.params/req.query */
    /* "noUncheckedIndexedAccess": true, */
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,

    /* ---- Calidad ---- */
    "skipLibCheck": true /* Ignora chequeos en libs de terceros */,
    "forceConsistentCasingInFileNames": true,
    "noEmitOnError": true,

    /* ---- Mapas de depuración ---- */
    "sourceMap": true /* Genera archivos .map para depurar TS en Node */,
    "inlineSourceMap": false,

    "paths": {
      "@/*": ["./src/*"],
      "@config/*": ["./src/config/*"],
      "@modules/*": ["./src/modules/*"],
      "@middlewares/*": ["./src/middlewares/*"],
      "@utils/*": ["./src/utils/*"],
      "@prisma-client": ["./src/prisma/client"],
      "@tests/*": ["./src/tests/*"]
    }
  },
  "include": ["src", "src/types/express.d.ts"],
  "exclude": ["node_modules", "dist", "prisma"]
}
