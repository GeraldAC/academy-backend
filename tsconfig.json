{
  "compilerOptions": {
    /* ---- Salida ---- */
    "rootDir": "src" /* Solo compilar carpeta src */,
    "outDir": "dist" /* Carpeta de salida después de compilar */,

    /* ---- Módulos y JS ---- */
    "target": "ES2024" /* Versión de JS a compilar - Soporte Node 20+ */,
    "module": "Node16",
    "moduleResolution": "Node16",
    "typeRoots": ["./node_modules/@types", "./src/types"],

    /* ---- Declaration - Genera tipos .d.ts ---- */
    "declaration": false,
    "declarationMap": false,

    /* ---- Compatibilidad ---- */
    "esModuleInterop": true /* Permitir importaciones de módulos CommonJS */,
    "resolveJsonModule": true /* Importar archivos .json */,
    "allowSyntheticDefaultImports": true,

    /* ---- Compilación Incremental - Optimiza builds consecutivas ---- */
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",

    /* ---- Strictness Avanzada ---- */
    "strict": true /* Habilita todas las comprobaciones estrictas */,
    /* NOTA: Deshabilitado temporalmente - requiere validar req.params/req.query */
    /* "noUncheckedIndexedAccess": true, */
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,

    /* ---- Calidad ---- */
    "skipLibCheck": true /* Ignora chequeos en libs de terceros */,
    "forceConsistentCasingInFileNames": true,
    "noEmitOnError": true,

    /* ---- Mapas de depuración ---- */
    "sourceMap": true /* Genera archivos .map para depurar TS en Node */,
    "inlineSourceMap": false
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.spec.ts",
    "prisma/seed.ts",
    "prisma/seeds/**"
  ]
}
